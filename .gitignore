# Secrets and runtime state
.env
.env.*
!.env.example
.runtime/
secrets/

# Hermes: version only personal configuration; ignore all generated state,
# credentials, caches, databases, and runtime metadata.
.hermes/*
!.hermes/README.md
!.hermes/SOUL.md
!.hermes/config.yaml

# Bundled skills are seeded runtime/vendor content. Keep only intentionally
# authored workspace skills under the dedicated `hermes/` category in Git.
!.hermes/skills/
.hermes/skills/**
!.hermes/skills/hermes/
!.hermes/skills/hermes/**

# Local/editor artifacts
.DS_Store
*.log
__pycache__/
*.py[cod]
