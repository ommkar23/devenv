# Secrets and runtime state
.env
.env.*
!.env.example
.runtime/
secrets/

# Hermes: version only personal configuration; ignore all generated state,
# credentials, caches, databases, and runtime metadata.
.hermes/*
!.hermes/README.md
!.hermes/SOUL.md
!.hermes/config.yaml

# Version reusable skills and their supporting files, but not local Skill Hub
# indexes, locks, or usage counters.
!.hermes/skills/
!.hermes/skills/**
.hermes/skills/.hub/
.hermes/skills/.usage.json*

# Local/editor artifacts
.DS_Store
*.log
