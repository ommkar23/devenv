# Secrets and runtime state
.env
.env.*
!.env.example
.runtime/
secrets/

# Hermes: version configuration and skills, never credentials or runtime data
.hermes/.env
.hermes/auth.json
.hermes/state.db
.hermes/sessions/
.hermes/logs/
.hermes/cache/
.hermes/*.db
# SOUL.md is intentional, versioned agent behavior.
!.hermes/SOUL.md

# Codex: version non-secret instructions/config only
.codex/auth.json
.codex/session_store.jsonl
.codex/sessions/
.codex/log/
.codex/tmp/

# Local/editor/container artifacts
.DS_Store
*.log
.devcontainer/devcontainer.local.json
